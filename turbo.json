{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": [".output/**", "src/routeTree.gen.ts"],
      "inputs": ["$TURBO_DEFAULT$", "!src/routeTree.gen.ts", ".env", ".env.*"],
      "env": ["VITE_*", "NITRO_*", "NODE_ENV"]
    },
    "@sky/macos#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["build/**"],
      "passThroughEnv": [
        "CONFIG",
        "SIGN_IDENTITY",
        "DEVELOPER_DIR",
        "SDKROOT",
        "TOOLCHAINS"
      ]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!src/routeTree.gen.ts"],
      "outputs": ["src/routeTree.gen.ts"]
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["DEVELOPER_DIR", "SDKROOT", "TOOLCHAINS"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DEVELOPER_DIR", "SDKROOT", "TOOLCHAINS"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "HOST",
        "NODE_ENV",
        "NITRO_*",
        "SERVER_*",
        "TLS_*",
        "UNIX_SOCKET"
      ]
    }
  }
}
